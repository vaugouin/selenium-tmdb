# Credentials for themoviedb.org
TMDB_LOGIN=your_tmdb_login
TMDB_PASSWORD=your_tmdb_password

SFTP_HOST=your_sftp_host
SFTP_PORT=22
SFTP_LOGIN=your_sftp_login
SFTP_FOLDER=your_sftp_folder

# Server verification, in the WinSCP SshHostKeyFingerprint format:
#   ssh-ed25519 256 SHA256:<base64>
# The key type, the bit count and the SHA256: prefix are optional, and an MD5
# fingerprint (aa:bb:...:ff) is accepted too.
SFTP_SSHHOSTKEYFINGERPRINT=your_sftp_ssh_host_key_fingerprint

# First choice: SSH public-key authentication with SFTP_LOGIN.
# Leave SFTP_KEY empty to use the IdentityFile declared for SFTP_HOST in
# ~/.ssh/config, or the default ~/.ssh/id_* keys. Set SFTP_KEY_PASSPHRASE only
# if you do not want the notebook to prompt for a passphrase-protected key.
SFTP_KEY=
SFTP_KEY_PASSPHRASE=

# Second choice: password authentication. Leave empty to disable it.
SFTP_PASSWORD=
